# Local / container configuration
MOTIVA_HOST=127.0.0.1
MOTIVA_PORT=8787
MOTIVA_DB_PATH=app/motiva.sqlite3

# A robot is reported offline when its last heartbeat is older than this.
MOTIVA_HEARTBEAT_TIMEOUT_SECONDS=30

# Site size in metres covered by the dashboard's 0-100 grid. VDA 5050 state
# coordinates are metres on the vehicle's map and are scaled to this extent.
MOTIVA_MAP_EXTENT_METRES=100

# Webhook signing secret for POST /api/integrations/events. Empty disables the endpoint (503).
MOTIVA_WEBHOOK_SECRET=

# Docker Compose host ports
MOTIVA_API_PORT=8787
MOTIVA_LANDING_PORT=8080
MOTIVA_DB_PORT=5432
MOTIVA_MQTT_DASHBOARD_PORT=18083
MOTIVA_KEYCLOAK_PORT=8081

# Docker Compose credentials for the optional platform profile
MOTIVA_DB_PASSWORD=motiva-local-only
MOTIVA_MQTT_DASHBOARD_PASSWORD=motiva-local-only
MOTIVA_KEYCLOAK_ADMIN=admin
MOTIVA_KEYCLOAK_PASSWORD=motiva-local-only
